{
  "name": "fortephp/sheath-statamic",
  "description": "Statamic v6 rules and source integration for the Sheath Blade linter.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "statamic",
    "laravel",
    "blade",
    "blade linter",
    "static analysis"
  ],
  "authors": [
    {
      "name": "John Koster",
      "email": "john@stillat.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "fortephp/sheath": "^1.0",
    "statamic/cms": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^3.0",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Forte\\Sheath\\Statamic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Forte\\Sheath\\Statamic\\Tests\\": "tests/"
    }
  },
  "archive": {
    "exclude": [
      "/.gitattributes"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Forte\\Sheath\\Statamic\\ServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "rector": "rector process --dry-run"
  }
}
